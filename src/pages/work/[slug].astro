---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allProjects = (await getCollection('projects', ({ data }) => data.status === 'published')).sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const position = allProjects.findIndex((item) => item.id === entry.id);
const previousProject = position > 0 ? allProjects[position - 1] : null;
const nextProject = position >= 0 && position < allProjects.length - 1 ? allProjects[position + 1] : null;
---

<BaseLayout title={`${entry.data.title} — ${site.name}`} description={entry.data.description}>
  <main id="main-content" class="case-page">
    <header class="case-hero">
      <a class="back-link" href="/work/">← All work</a>
      <p class="eyebrow">{entry.data.type} · {entry.data.year}</p>
      <h1>{entry.data.title}</h1>
      <p class="case-deck">{entry.data.description}</p>
      <div class="case-meta">
        <span><strong>Role</strong>{entry.data.role}</span>
        <span><strong>Stack</strong>{entry.data.stack.join(' · ')}</span>
      </div>
    </header>

    {entry.data.image && <img class="case-image" src={entry.data.image} alt="" decoding="async" />}

    <article class="rich-content">
      <Content />
    </article>

    {entry.id === 'sketchbook-engine' && (
      <aside class="source-credit" aria-label="Source credit">
        <span>Original reference</span>
        <p>This interaction is based on the public ThreeUI “Meng To — Sketchbook” experience. ThreeUI remains credited in the project README and documentation. The site does not present the original creator’s personal identity as the site owner.</p>
        <a href="https://threeui.com/landing-pages/meng-to-sketchbook.html" rel="noreferrer">View original reference ↗</a>
      </aside>
    )}

    <nav class="project-pager" aria-label="Project navigation">
      {previousProject ? <a href={`/work/${previousProject.id}/`}><span>Previous</span><strong>{previousProject.data.title}</strong></a> : <span></span>}
      {nextProject ? <a class="next" href={`/work/${nextProject.id}/`}><span>Next</span><strong>{nextProject.data.title}</strong></a> : <span></span>}
    </nav>
  </main>
</BaseLayout>

<style>
.case-page { max-width: 1000px; margin: 0 auto; padding: 130px clamp(20px,5vw,48px) 120px; }
.case-hero { padding: 90px 0 70px; }
.back-link { color: var(--ink-soft); text-decoration: none; font-size: 13px; }
.back-link:hover { color: var(--ink); }
.case-hero .eyebrow { margin-top: 70px; }
.case-hero h1 { max-width: 11ch; margin: 0; font: 400 clamp(58px, 9vw, 120px)/.88 var(--display); letter-spacing: -.035em; }
.case-deck { max-width: 58ch; margin: 30px 0 0; color: var(--ink-soft); font-size: clamp(18px,2vw,23px); line-height: 1.55; }
.case-meta { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; margin-top: 46px; padding-top: 18px; border-top: 1px solid var(--hairline); }
.case-meta span { display: grid; gap: 5px; color: var(--ink-soft); font-size: 13px; }
.case-meta strong { color: var(--ink-faint); font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
.case-image { display: block; width: 100%; max-height: 680px; object-fit: cover; border: 1px solid var(--hairline); }
.rich-content { max-width: 68ch; margin: 90px auto 0; font-size: 18px; line-height: 1.8; }
.rich-content :global(h2) { margin: 3em 0 1rem; font: 400 clamp(34px,5vw,54px)/1 var(--display); }
.rich-content :global(p) { margin: 0 0 1.35em; }
.rich-content :global(a) { color: inherit; }
.source-credit { max-width: 68ch; margin: 70px auto 0; padding: 18px 0; border-block: 1px solid var(--hairline); }
.source-credit span { color: var(--ink-faint); font-size: 10px; letter-spacing:.13em; text-transform:uppercase; }
.source-credit p { margin: 12px 0; color: var(--ink-soft); line-height:1.6; }
.source-credit a { color:var(--ink); font-size:13px; }
.project-pager { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:70px; }
.project-pager a { display:grid; gap:5px; min-height:90px; padding:18px; border:1px solid var(--hairline); color:inherit; text-decoration:none; }
.project-pager a:hover { background:rgba(43,39,33,.035); }
.project-pager .next { text-align:right; }
.project-pager span { color:var(--ink-faint); font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
.project-pager strong { font:400 28px/.95 var(--display); }
@media (max-width:700px) { .case-meta { grid-template-columns: 1fr; } }
</style>
