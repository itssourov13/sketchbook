---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/Portfolio/ReadingProgress.astro';
import ArticleCard from '../../components/Portfolio/ArticleCard.astro';
import '../../components/Portfolio/portfolio.css';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const related = (await getCollection('journal', ({ data }) => data.status === 'published'))
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title={`${entry.data.title} — Journal — Samir`} description={entry.data.description}>
  <ReadingProgress />
  <main id="main-content" class="article-page">
    <a class="back-link" href="/journal/">← Journal</a>
    <header class="article-header">
      <p class="eyebrow">{entry.data.category} · {published}{entry.data.readingTime ? ` · ${entry.data.readingTime}` : ''}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      {entry.data.cover && <img class="article-cover" src={entry.data.cover} alt="" decoding="async" />}
    </header>
    <article class="rich-content"><Content /></article>

    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="section-heading"><div><p class="eyebrow">Keep reading</p><h2 id="related-title">Related notes</h2></div></div>
        <div class="article-grid">
          {related.map((post) => <ArticleCard {...post.data} href={`/journal/${post.id}/`} />)}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
.article-page { max-width: 1000px; margin: 0 auto; padding: 130px clamp(20px,5vw,48px) 120px; }
.back-link { color: var(--ink-soft); text-decoration: none; font-size: 13px; }
.back-link:hover { color: var(--ink); }
.article-header { padding: 90px 0 80px; }
.eyebrow { margin: 0 0 20px; color: var(--ink-faint); font-size: 11px; letter-spacing: .13em; text-transform: uppercase; }
.article-header h1 { max-width: 12ch; margin: 0; font: 400 clamp(56px, 9vw, 116px)/.88 var(--display); letter-spacing: -.035em; }
.article-deck { max-width: 56ch; margin: 28px 0 0; color: var(--ink-soft); font-size: clamp(18px,2vw,24px); line-height: 1.52; }
.article-cover { width: 100%; max-height: 620px; object-fit: cover; display: block; margin-top: 64px; border: 1px solid var(--hairline); }
.rich-content { max-width: 68ch; margin: 0 auto; font-size: 19px; line-height: 1.85; }
.rich-content :global(h2) { margin: 3.2em 0 1rem; font: 400 clamp(34px,5vw,54px)/1 var(--display); }
.rich-content :global(p) { margin: 0 0 1.45em; }
.rich-content :global(strong) { font-weight: 600; }
.related-section { max-width: 1000px; margin-top: 100px; padding-top: 12px; border-top:1px solid var(--hairline); }
.related-section .section-heading { margin-top:0; }
</style>
