---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sketchbook from '../components/sketchbook/Sketchbook.astro';
import ProjectCard from '../components/Portfolio/ProjectCard.astro';
import ArticleCard from '../components/Portfolio/ArticleCard.astro';
import { site } from '../data/site';
import '../components/Portfolio/portfolio.css';

const projects = (await getCollection('projects', ({ data }) => data.status === 'published' && data.featured))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
const posts = (await getCollection('journal', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout
  title={`${site.name} — Poems, Prose & Quiet Things`}
  description={`Poems, fragments, prose, and a visual sketchbook by ${site.name}.`}
>
  <main id="main-content" class="home-page">
    <section class="personal-hero">
      <div class="personal-hero-top">
        <p class="eyebrow">Bangladesh · Writing · Poetry · Prose</p>
        <span class="hero-year">2026 / now</span>
      </div>
      <h1>Some words are meant.<br /><em>to linger.</em></h1>
      <div class="personal-hero-bottom">
        <p>I write toward the small things: a passing image, a remembered room, a sentence that refuses to leave. This is a place for poems, fragments, and the space between them.</p>
        <a class="text-link" href="/work/">Enter the writing ↗</a>
      </div>
    </section>

    <section class="signature-section" aria-labelledby="signature-title">
      <div class="section-heading-block">
        <p class="eyebrow">A page to pause on</p>
        <h2 id="signature-title">A sketchbook<br /><em>for looking twice.</em></h2>
        <p>The pages turn slowly here—a visual pause beside the writing. Look closely, turn one more page, and let the small details take their time.</p>
      </div>
      <div class="signature-frame">
        <Sketchbook mode="hero" kicker="Quiet pages / visual study" />
      </div>
      <div class="signature-caption"><span>Turn a page, stay awhile.</span><a class="text-link" href="/sketchbook/">Open the sketchbook ↗</a></div>
    </section>

    <section class="content-section home-work" aria-labelledby="featured-work-title">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Recent pieces</p><h2 id="featured-work-title">Recent writing</h2></div>
        <a class="text-link" href="/work/">Read everything ↗</a>
      </div>
      <div class="work-grid">
        {projects.map((project) => <ProjectCard {...project.data} href={`/work/${project.id}/`} />)}
      </div>
    </section>

    <section class="content-section home-journal" aria-labelledby="journal-title">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Notes</p><h2 id="journal-title">Notes, fragments, things kept</h2></div>
        <a class="text-link" href="/journal/">All notes ↗</a>
      </div>
      <div class="article-grid">
        {posts.map((post) => <ArticleCard {...post.data} href={`/journal/${post.id}/`} />)}
      </div>
    </section>

    <section class="home-about content-section" aria-labelledby="about-title">
      <div class="about-statement">
        <p class="eyebrow">03 / A little about this place</p>
        <h2 id="about-title">A room for words.<br /><em>Nothing louder than that.</em></h2>
      </div>
      <div class="about-copy">
        <p>I wanted a corner of the internet where a poem could sit beside a photograph, a fragment beside a longer thought, without having to become anything else. So this site is kept deliberately open: part notebook, part archive, part room to return to.</p>
        <div class="capability-grid">
          <span>Poems</span><span>Prose</span><span>Fragments</span><span>Observations</span><span>Images & memory</span><span>Sketchbook</span>
        </div>
        <a class="text-link" href="/about/">Read the note ↗</a>
      </div>
    </section>

    <section class="home-contact" aria-labelledby="contact-title">
      <p class="eyebrow">Come back later</p>
      <h2 id="contact-title">There is always<br /><em>another page.</em></h2>
      <a class="contact-link" href={site.github} rel="noreferrer">Find me elsewhere ↗</a>
    </section>
  </main>
</BaseLayout>

<style>
.home-page { max-width: 1180px; margin: 0 auto; padding: 120px clamp(20px,5vw,48px) 80px; }
.personal-hero { min-height: 82vh; padding: 100px 0 70px; display: flex; flex-direction: column; justify-content: space-between; }
.personal-hero-top, .personal-hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
.eyebrow { margin: 0; color: var(--ink-faint); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
.hero-year { color: var(--ink-faint); font-size: 11px; }
.personal-hero h1 { max-width: 1100px; margin: 50px 0; font: 400 clamp(72px, 13vw, 178px)/.82 var(--display); letter-spacing: -.045em; }
.personal-hero h1 em, .section-heading-block h2 em, .home-about h2 em, .home-contact h2 em { color: var(--earth); }
.personal-hero-bottom p { max-width: 36ch; margin: 0; color: var(--ink-soft); font-size: clamp(17px,1.8vw,21px); line-height: 1.5; }
.text-link { color: var(--ink); text-decoration: none; font-size: 13px; white-space: nowrap; }
.text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
.signature-section { padding: 40px 0 100px; }
.section-heading-block { max-width: 620px; padding: 0 0 34px; }
.section-heading-block h2 { margin: 10px 0 16px; font: 400 clamp(48px, 7vw, 88px)/.92 var(--display); letter-spacing: -.03em; }
.section-heading-block > p:last-child { max-width: 42ch; margin: 0; color: var(--ink-soft); font-size: 17px; line-height: 1.55; }
.signature-frame { border: 1px solid var(--hairline); overflow: hidden; background: var(--paper); }
.signature-frame .home { margin: 0; }
.signature-caption { display: flex; justify-content: space-between; gap: 20px; padding-top: 14px; color: var(--ink-faint); font-size: 12px; }
.content-section { padding: 110px 0 40px; content-visibility: auto; contain-intrinsic-size: 760px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 18px 0; margin-bottom: 28px; border-top: 1px solid var(--hairline); }
.section-heading h2 { margin: 7px 0 0; font: 400 clamp(38px,5vw,68px)/.94 var(--display); letter-spacing: -.025em; }
.home-about { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0,.95fr); gap: clamp(36px, 8vw, 120px); align-items: start; }
.home-about h2 { margin: 0; font: 400 clamp(54px, 8vw, 104px)/.88 var(--display); letter-spacing: -.035em; }
.about-copy > p { margin: 0; color: var(--ink-soft); font-size: clamp(18px,2vw,23px); line-height: 1.55; }
.capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 0; margin: 44px 0 34px; border-top: 1px solid var(--hairline); }
.capability-grid span { padding: 13px 0; border-bottom: 1px solid var(--hairline); color: var(--ink-soft); font-size: 13px; }
.home-contact { content-visibility: auto; contain-intrinsic-size: 520px; margin: 120px 0 60px; padding: 80px 0; text-align: center; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
.home-contact h2 { margin: 16px auto 30px; font: 400 clamp(52px,9vw,118px)/.86 var(--display); letter-spacing: -.04em; }
.contact-link { color: var(--ink); font-size: clamp(16px,2vw,24px); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent); text-underline-offset: 6px; }
@media (max-width: 760px) {
  .personal-hero { min-height: 76vh; }
  .personal-hero-top, .personal-hero-bottom { align-items: start; flex-direction: column; }
  .personal-hero h1 { margin: 60px 0; }
  .home-about { grid-template-columns: 1fr; }
  .signature-caption { align-items: start; flex-direction: column; }
}
</style>
