---
import '../styles/global.css';
import SiteNav from '../components/Navigation/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
}

const {
  title = 'Sketchbook',
  description = 'An interactive editorial portfolio experience.',
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ece7dc" />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {chrome && <SiteNav />}
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
