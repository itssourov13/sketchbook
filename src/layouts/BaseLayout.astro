---
import '../styles/global.css';
import SiteNav from '../components/Navigation/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
  image?: string;
}

const {
  title = `${site.name} — personal site`,
  description = 'An interactive editorial portfolio experience.',
  chrome = true,
  image = '/assets/bloom.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ece7dc" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="preload" href="/assets/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {chrome && <SiteNav />}
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
