<div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>

<script>
  const bar = document.querySelector('[data-reading-progress] span');
  const article = document.querySelector('.rich-content');
  if (bar instanceof HTMLElement && article instanceof HTMLElement) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = Math.max(1, article.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - (rect.top + window.scrollY - 120)) / total));
      bar.style.transform = `scaleX(${progress})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
.reading-progress { position: fixed; inset: 0 0 auto; z-index: 90; height: 2px; pointer-events:none; }
.reading-progress span { display:block; width:100%; height:100%; background:var(--earth); transform:scaleX(0); transform-origin:left center; }
</style>
