{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "role": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "status": {
      "default": "published",
      "type": "string",
      "enum": [
        "published",
        "draft"
      ]
    },
    "stack": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "year",
    "role",
    "type"
  ]
}